{
  "skill_id": "risk_scoring",
  "version": "1.0.0",
  "name": "Risk Scoring Skill",
  "description": "Compute composite risk scores for investigations based on wallet classifications, mixer interactions, bridge crossings, exchange endpoints, and anomaly detection.",
  "category": "risk",
  "trigger": {
    "type": "internal",
    "invoked_by": "aml_investigation (step 5: assess)"
  },
  "algorithm": {
    "base_factors": [
      {"factor": "mixer_interaction", "weight": 30, "description": "Any wallet interacting with known mixers (Tornado Cash, etc.)"},
      {"factor": "bridge_crossing", "weight": 20, "description": "Cross-chain fund movement through bridges"},
      {"factor": "exchange_endpoint", "weight": 10, "description": "Funds reaching centralized exchange deposit addresses"},
      {"factor": "anomaly_detection", "weight": 15, "description": "Statistical anomaly in transaction patterns"}
    ],
    "normalization": "min(100, base_score + contextual_adjustments)",
    "labels": [
      {"label": "CRITICAL", "threshold": "≥ 70", "color": "#ef4444"},
      {"label": "HIGH", "threshold": "≥ 50", "color": "#f59e0b"},
      {"label": "MEDIUM", "threshold": "≥ 25", "color": "#eab308"},
      {"label": "LOW", "threshold": "< 25", "color": "#22c55e"}
    ]
  },
  "outputs": {
    "risk_score": "integer (0-100)",
    "risk_label": "CRITICAL|HIGH|MEDIUM|LOW",
    "exchange_count": "integer",
    "mixer_count": "integer",
    "bridge_count": "integer",
    "flagged_wallets": "integer"
  }
}
