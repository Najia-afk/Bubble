# =============================================================================
# Bubble - Docker Build Ignore
# =============================================================================

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.mypy_cache
.pytest_cache
.coverage
htmlcov/

# Virtual environments
.venv
venv/
ENV/
env/

# Version control
.git
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs (mounted as volume, don't bake in)
logs/*.log
logs/*_log

# Docker compose (not needed in build)
docker-compose*.yml
.dockerignore

# Documentation (optional in container)
docs/
LICENSE

# Notebooks (not needed in production image)
notebooks/
