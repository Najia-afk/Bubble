# =============================================================================
# Bubble - Blockchain Analytics Platform
# Environment Configuration Template
# =============================================================================
# Copy to .env and update:  cp .env.example .env
# =============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bubble_db
POSTGRES_USER=bubble_user
POSTGRES_PASSWORD=bubble_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# TigerGraph Configuration (optional)
TIGERGRAPH_HOST=tigergraph
TIGERGRAPH_PORT=9000
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH_NAME=BubbleGraph

# API Keys - Obtain from respective block explorer sites
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=

# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5005

# Logging
LOG_LEVEL=INFO
LOG_DIR=/app/logs
